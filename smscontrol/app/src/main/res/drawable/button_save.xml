<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="0dp"
        android:bottom="3dp">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#EF4444"
                android:endColor="#DC2626"
                android:type="linear"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item
        android:top="0dp"
        android:bottom="1dp">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#F87171"
                android:endColor="#EF4444"
                android:type="linear"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item
        android:top="0dp"
        android:bottom="1dp">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#30FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</layer-list>