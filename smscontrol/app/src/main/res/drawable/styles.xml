<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#6366F1</item>
        <item name="colorPrimaryVariant">#4F46E5</item>
        <item name="colorAccent">#EC4899</item>
    </style>

    <style name="SectionHeaderStyle">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#1C1C1E</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CardTitleStyle">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#1C1C1E</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CardSubtitleStyle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="SwitchTheme" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">#34C759</item>
        <item name="colorSwitchThumbNormal">#FFFFFF</item>
    </style>

</resources>