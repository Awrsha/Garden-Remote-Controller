<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Icon (Emoji)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1C1C1E"
            android:letterSpacing="0.01"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/iconInput"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:hint="⚙️"
            android:inputType="text"
            android:padding="16dp"
            android:background="@drawable/bg_input_samsung"
            android:textColor="#1C1C1E"
            android:textSize="32sp"
            android:gravity="center"
            android:maxLength="2"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Label *"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1C1C1E"
            android:letterSpacing="0.01"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/labelInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Device Name"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_samsung"
            android:textColor="#1C1C1E"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1C1C1E"
            android:letterSpacing="0.01"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/descInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Device description"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_samsung"
            android:textColor="#1C1C1E"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Command Text *"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1C1C1E"
            android:letterSpacing="0.01"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/commandInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="CMD"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_samsung"
            android:textColor="#1C1C1E"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Command Key (optional)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1C1C1E"
            android:letterSpacing="0.01"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/keyInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="cmd_key"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_input_samsung"
            android:textColor="#1C1C1E"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_samsung"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Toggleable (On/Off)"
                android:textSize="16sp"
                android:textColor="#1C1C1E"
                android:letterSpacing="-0.01"/>

            <Switch
                android:id="@+id/toggleSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* Required fields"
            android:textSize="12sp"
            android:textColor="#8E8E93"
            android:layout_marginTop="16dp"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>