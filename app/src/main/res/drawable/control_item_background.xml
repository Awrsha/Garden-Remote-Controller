<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="4dp">
        <shape>
            <solid android:color="#08000000"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Main card -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="#FFFFFF"/>
            <corners android:radius="20dp"/>
            <stroke android:width="0.5dp" android:color="#E5E5E7"/>
        </shape>
    </item>
    <!-- Highlight layer -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="2dp">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#05FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>