<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="1dp"
        android:bottom="3dp">
        <shape>
            <solid android:color="#05000000"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item
        android:top="0dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="#FFFFFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item
        android:top="0dp"
        android:bottom="2dp">
        <shape>
            <stroke android:width="0.5dp" android:color="#E5E5E7"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>